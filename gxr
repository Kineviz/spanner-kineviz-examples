#!/usr/bin/env bash
#
# gxr — the one command for both people and agents.
#
#   ./gxr list                list demos and their status
#   ./gxr up <slug>           preflight → setup → verify → handoff
#   ./gxr preflight <slug>    check prerequisites only; creates nothing
#   ./gxr verify <slug>       assert the demo works, with a real query
#   ./gxr down <slug>         teardown; asks first
#   ./gxr doctor              run the same checks CI runs
#
# Add --json to any command for structured output.

set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$REPO_ROOT/shared/lib/common.sh"

for arg in "$@"; do
  [ "$arg" = "--json" ] && { GXR_JSON=1; export GXR_JSON; }
done

usage() {
  sed -n '3,14p' "$REPO_ROOT/gxr" | sed 's/^# \{0,1\}//'
  exit "${1:-0}"
}

demo_path() {
  local slug="$1" path="$REPO_ROOT/demos/$1"
  [ -d "$path" ] || die "No demo named '$slug'." "Run './gxr list' to see what exists."
  echo "$path"
}

# Read one top-level scalar out of demo.yaml without a YAML dependency.
# Deliberately dumb: demo.yaml is schema-validated in CI, so this only ever
# runs against files that already passed.
yaml_get() {
  local file="$1" key="$2"
  sed -n "s/^${key}:[[:space:]]*//p" "$file" | head -1 | sed 's/^["'\'']//; s/["'\'']$//'
}

cmd_list() {
  local any=0
  if [ "$GXR_JSON" = 1 ]; then
    printf '['
    for d in "$REPO_ROOT"/demos/*/; do
      [ -f "$d/demo.yaml" ] || continue
      [ "$any" = 1 ] && printf ','
      printf '{"slug":"%s","status":"%s","time_minutes":%s}' \
        "$(yaml_get "$d/demo.yaml" slug)" \
        "$(yaml_get "$d/demo.yaml" status)" \
        "$(yaml_get "$d/demo.yaml" time_minutes)"
      any=1
    done
    printf ']\n'; return
  fi

  printf '\n%sDemos%s\n\n' "$_c_bold" "$_c_reset"
  for d in "$REPO_ROOT"/demos/*/; do
    [ -f "$d/demo.yaml" ] || continue
    local slug status mins title
    slug=$(yaml_get "$d/demo.yaml" slug)
    status=$(yaml_get "$d/demo.yaml" status)
    mins=$(yaml_get "$d/demo.yaml" time_minutes)
    title=$(yaml_get "$d/demo.yaml" title)
    local badge="  "
    [ "$status" = "preview" ] && badge="${_c_yellow}~${_c_reset} "
    [ "$status" = "pending-upstream" ] && badge="${_c_dim}·${_c_reset} "
    printf '  %s%-26s %s%s — %s min%s\n' "$badge" "$slug" "$_c_dim" "$title" "$mins" "$_c_reset"
    any=1
  done
  [ "$any" = 0 ] && printf '  %s(none yet)%s\n' "$_c_dim" "$_c_reset"

  printf '\n  %sJust want your own data in Kineviz? See connect/ — no demo needed.%s\n\n' \
    "$_c_dim" "$_c_reset"
}

run_step() {
  local dir="$1" id="$2" required="${3:-yes}"
  local script="$dir/scripts/$id.sh"
  if [ ! -x "$script" ]; then
    [ "$required" = "yes" ] && die "Missing or non-executable: scripts/$id.sh" \
      "This demo is incomplete. Please open an issue."
    return 0
  fi
  # NOT ${GXR_JSON:+--json}: common.sh defaults GXR_JSON to the STRING "0",
  # and :+ tests set-and-non-empty rather than truthiness, so that form passed
  # --json on every run and every `gxr up` emitted machine output to humans.
  if [ "$GXR_JSON" = 1 ]; then
    GXR_STEP="$id" "$script" --json
  else
    GXR_STEP="$id" "$script"
  fi
}

cmd_up() {
  local dir; dir=$(demo_path "$1")
  local status; status=$(yaml_get "$dir/demo.yaml" status)

  if [ "$status" = "pending-upstream" ]; then
    die "'$1' is blocked on an upstream capability that has not shipped." \
        "$(yaml_get "$dir/demo.yaml" maturity_note)"
  fi
  [ "$status" = "preview" ] && warn "'$1' runs against a pre-GA backend feature. See the README."

  run_step "$dir" preflight
  run_step "$dir" setup
  run_step "$dir" verify
  run_step "$dir" handoff
}

cmd_down() {
  local dir; dir=$(demo_path "$1")
  if [ "$GXR_JSON" != 1 ]; then
    printf '\n  This deletes the cloud resources %s created:\n' "$1"
    sed -n '/creates:/,/^[a-z]/p' "$dir/demo.yaml" | sed -n 's/.*- /    · /p'
    printf '\n'
    confirm "Delete them?" || { info "Nothing deleted."; exit 0; }
  fi
  run_step "$dir" teardown
}

cmd_doctor() {
  command -v python3 >/dev/null 2>&1 || die "python3 not found." "Install Python 3.9+."
  python3 "$REPO_ROOT/tools/check_contract.py" "$REPO_ROOT"
}

case "${1:-}" in
  list)              shift; cmd_list ;;
  up)                shift; [ $# -ge 1 ] || usage 1; cmd_up "$1" ;;
  preflight|verify)  c="$1"; shift; [ $# -ge 1 ] || usage 1; run_step "$(demo_path "$1")" "$c" ;;
  down|teardown)     shift; [ $# -ge 1 ] || usage 1; cmd_down "$1" ;;
  doctor)            shift; cmd_doctor ;;
  ""|-h|--help|help) usage 0 ;;
  *)                 printf 'Unknown command: %s\n\n' "$1" >&2; usage 1 ;;
esac
