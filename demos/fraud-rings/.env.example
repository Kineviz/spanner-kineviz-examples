# Copy to .env and fill in. .env is gitignored — never commit it.

GCP_PROJECT=your-project-id

# The Spanner INSTANCE to create the demo database in.
#
# READ THIS BEFORE RUNNING. Spanner bills for provisioned capacity continuously,
# unlike BigQuery which bills per query. The instance is the expensive part; a
# database inside one you already run is storage-only and effectively free at
# this scale.
#
# So this demo creates a DATABASE in an instance you already have, and teardown
# drops only that database — never the instance, which may hold other people's
# work.
#
# No instance yet? A free trial instance is the right on-ramp (90 days, no
# charge): https://docs.cloud.google.com/spanner/docs/free-trial-instance
#   gcloud spanner instances list --project=YOUR_PROJECT
SPANNER_INSTANCE=your-instance

# The database this demo creates. Teardown drops exactly this.
SPANNER_DATABASE=kineviz_fraud_demo

# Property graph name, used in every query and in the Kineviz connect dialog.
SPANNER_GRAPH=FraudGraph

# Synthetic data volume. Seeded, so the same numbers always produce the same
# graph — including the rings the queries find.
FRAUD_CLIENTS=300
FRAUD_TRANSACTIONS=2000
FRAUD_DAYS=30
FRAUD_SEED=20260813
